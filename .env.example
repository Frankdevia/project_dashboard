PORT=3000
DATA_DIR=/app/data
# Login. The whole dashboard requires a session.
# Admin account (full access). Agent accounts are created by the admin in /usuarios.html
# and stored in data/users.json; each agent only sees their own My Dashboard.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Days a login lasts (sessions survive redeploys; stored hashed in data/sessions.json)
SESSION_DAYS=7
# FreeScout MCP server (Streamable HTTP) used for the Tickets page
FREESCOUT_MCP_URL=https://tu-servidor-mcp/mcp
FREESCOUT_MCP_TOKEN=
FREESCOUT_CACHE_MINUTES=5
# Only this mailbox and these agents are counted on the Tickets page
FREESCOUT_MAILBOX=Techsupport
FREESCOUT_AGENTS=Steven Solano,Jorge Agudelo,Isaac Gómez,Bryan Escobar,Emanuel Ríos Romero
# Public FreeScout URL, used for the "Abrir en FreeScout" link in ticket details
FREESCOUT_WEB_URL=https://tu-freescout
# Alarms: open tickets older than these calendar days are flagged (high / critical)
FREESCOUT_ALARMA_DIAS=7
FREESCOUT_ALARMA_DIAS_CRITICO=30
